@page "/"
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Дашборд | Банк «ФИНАНСОВЫЙ СТАНДАРТ»</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Панель управления кредитными заявками</h2>
            <p class="text-muted mb-0">Сводная аналитика, финансовые показатели и статус обработки портфеля</p>
        </div>
        <div class="d-flex gap-2">
            <a href="applications/create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Новая заявка
            </a>
            <a href="applications" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-list-ul"></i> Все заявки
            </a>
        </div>
    </div>

    @if (Stats == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка данных...</span>
            </div>
            <div class="text-muted mt-2">Загрузка аналитики дашборда...</div>
        </div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Всего заявок</span>
                                <h3 class="fw-bold my-1 text-dark">@Stats.TotalApplications</h3>
                                <span class="small text-muted">Клиентов в базе: @Stats.TotalClients</span>
                            </div>
                            <div class="rounded-circle bg-primary-subtle p-3 text-primary fs-3">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Новые заявки</span>
                                <h3 class="fw-bold my-1 text-info">@Stats.NewApplications</h3>
                                <span class="small text-muted">Ожидают первичной обработки</span>
                            </div>
                            <div class="rounded-circle bg-info-subtle p-3 text-info fs-3">
                                <i class="bi bi-file-earmark-plus"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-warning border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">В обработке</span>
                                <h3 class="fw-bold my-1 text-warning">@Stats.InProgressApplications</h3>
                                <span class="small text-muted">На этапе андеррайтинга</span>
                            </div>
                            <div class="rounded-circle bg-warning-subtle p-3 text-warning fs-3">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-success border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small text-uppercase fw-semibold">Одобрено</span>
                                <h3 class="fw-bold my-1 text-success">@Stats.ApprovedApplications</h3>
                                <span class="small text-success fw-medium">Конверсия: @Stats.ApprovalRatePercentage%</span>
                            </div>
                            <div class="rounded-circle bg-success-subtle p-3 text-success fs-3">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Summary & Status Progress -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack text-primary me-2"></i> Финансовые объемы</h5>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">Одобренный кредитный объем:</div>
                                    <div class="fs-4 fw-bold text-success mt-1">@Stats.TotalApprovedAmount.ToString("N0") ₽</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="text-muted small">Общий запрашиваемый объем:</div>
                                    <div class="fs-4 fw-bold text-dark mt-1">@Stats.TotalRequestedAmount.ToString("N0") ₽</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Доля одобрений в портфеле:</span>
                                <span class="fw-bold text-dark">@Stats.ApprovalRatePercentage%</span>
                            </div>
                            <div class="progress" style="height: 12px;">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @(Stats.ApprovalRatePercentage)%"
                                     aria-valuenow="@Stats.ApprovalRatePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-3 h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart text-primary me-2"></i> Структура по статусам</h5>
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small"><span class="badge bg-primary me-2">●</span> Новые</span>
                                <span class="fw-bold small">@Stats.NewApplications ( @GetPercent(Stats.NewApplications)% )</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small"><span class="badge bg-warning text-dark me-2">●</span> В обработке</span>
                                <span class="fw-bold small">@Stats.InProgressApplications ( @GetPercent(Stats.InProgressApplications)% )</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small"><span class="badge bg-success me-2">●</span> Одобрено</span>
                                <span class="fw-bold small">@Stats.ApprovedApplications ( @GetPercent(Stats.ApprovedApplications)% )</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small"><span class="badge bg-danger me-2">●</span> Отклонено</span>
                                <span class="fw-bold small">@Stats.RejectedApplications ( @GetPercent(Stats.RejectedApplications)% )</span>
                            </div>
                        </div>

                        <div class="progress-stacked mt-4" style="height: 14px;">
                            <div class="progress" style="width: @(GetPercent(Stats.NewApplications))%">
                                <div class="progress-bar bg-primary"></div>
                            </div>
                            <div class="progress" style="width: @(GetPercent(Stats.InProgressApplications))%">
                                <div class="progress-bar bg-warning"></div>
                            </div>
                            <div class="progress" style="width: @(GetPercent(Stats.ApprovedApplications))%">
                                <div class="progress-bar bg-success"></div>
                            </div>
                            <div class="progress" style="width: @(GetPercent(Stats.RejectedApplications))%">
                                <div class="progress-bar bg-danger"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Applications Table -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i> Недавние кредитные заявки</h5>
                <a href="applications" class="btn btn-sm btn-outline-primary">Перейти в реестр →</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Номер заявки</th>
                            <th>Дата</th>
                            <th>Клиент</th>
                            <th>Продукт</th>
                            <th>Сумма</th>
                            <th>Срок</th>
                            <th>Статус</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Stats.RecentApplications.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Заявок пока нет</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Stats.RecentApplications)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@app.ApplicationNumber</td>
                                    <td class="small text-muted">@app.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-medium">@app.ClientFullName</div>
                                        <div class="small text-muted">ИНН: @app.ClientTaxNumber</div>
                                    </td>
                                    <td>@GetProductTitle(app.ProductType)</td>
                                    <td class="fw-semibold">@app.LoanAmount.ToString("N0") ₽</td>
                                    <td>@app.LoanTermMonths мес.</td>
                                    <td>
                                        <span class="badge @GetStatusBadge(app.Status)">@app.StatusTitle</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="applications/@app.Id" class="btn btn-sm btn-outline-secondary">
                                            Открыть
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private DashboardStatsDto? Stats;

    protected override async Task OnInitializedAsync()
    {
        Stats = await DashboardService.GetStatsAsync();
    }

    private double GetPercent(int count)
    {
        if (Stats == null || Stats.TotalApplications == 0) return 0;
        return Math.Round((double)count / Stats.TotalApplications * 100, 1);
    }

    private static string GetStatusBadge(ApplicationStatus status) => status switch
    {
        ApplicationStatus.New => "bg-primary",
        ApplicationStatus.InProgress => "bg-warning text-dark",
        ApplicationStatus.Approved => "bg-success",
        ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetProductTitle(ProductType type) => type switch
    {
        ProductType.ConsumerLoan => "Потребительский",
        ProductType.Mortgage => "Ипотека",
        ProductType.AutoLoan => "Автокредит",
        ProductType.BusinessLoan => "Бизнес",
        _ => type.ToString()
    };
}
