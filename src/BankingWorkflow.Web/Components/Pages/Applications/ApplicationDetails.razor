@page "/applications/{Id:guid}"
@rendermode InteractiveServer
@inject IApplicationService ApplicationService
@inject IDocumentService DocumentService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Заявка @(App?.ApplicationNumber ?? "") | Банк «ФИНАНСОВЫЙ СТАНДАРТ»</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="applications" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> Назад в реестр
                </a>
                <h3 class="fw-bold mb-0">Кредитная заявка @App?.ApplicationNumber</h3>
                @if (App != null)
                {
                    <span class="badge fs-6 @GetStatusBadge(App.Status)">@App.StatusTitle</span>
                }
            </div>
            <div class="text-muted small mt-1">
                Дата регистрации: @App?.CreatedAt.ToString("dd.MM.yyyy HH:mm") | Ответственный: @App?.CreatedByUserName
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (App != null)
            {
                <a href="/api/reports/agreement/@App.Id" target="_blank" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-word"></i> Договор займа (.docx)
                </a>
                <a href="/api/reports/decision/@App.Id" target="_blank" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text"></i> Выписка решения (.docx)
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }

    @if (App == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="text-muted mt-2">Загрузка информации по заявке...</div>
        </div>
    }
    else
    {
        <!-- Workflow State Machine Actions Bar -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
            <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small text-muted text-uppercase">Статус жизненного цикла:</span>
                    <span class="badge @GetStatusBadge(App.Status) fs-6">@App.StatusTitle</span>
                </div>

                <div class="d-flex gap-2">
                    @if (App.Status == ApplicationStatus.New)
                    {
                        <button class="btn btn-warning text-dark fw-bold d-flex align-items-center gap-2"
                                @onclick="() => PromptStatusChange(ApplicationStatus.InProgress)">
                            <i class="bi bi-arrow-right-circle"></i> Взять в обработку (IN_PROGRESS)
                        </button>
                    }
                    else if (App.Status == ApplicationStatus.InProgress)
                    {
                        <button class="btn btn-success fw-bold d-flex align-items-center gap-2"
                                @onclick="() => PromptStatusChange(ApplicationStatus.Approved)">
                            <i class="bi bi-check-lg"></i> Одобрить заявку (APPROVED)
                        </button>
                        <button class="btn btn-danger fw-bold d-flex align-items-center gap-2"
                                @onclick="() => PromptStatusChange(ApplicationStatus.Rejected)">
                            <i class="bi bi-x-lg"></i> Отклонить заявку (REJECTED)
                        </button>
                    }
                    else
                    {
                        <span class="text-muted small">
                            <i class="bi bi-lock-fill me-1"></i> Решение по заявке принято (финальный статус)
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Financial & Client Details -->
            <div class="col-lg-7">
                <!-- Loan Metrics -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0"><i class="bi bi-wallet2 text-primary me-2"></i> Параметры кредитования</h5>
                        <span class="badge bg-secondary">@GetProductTitle(App.ProductType)</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <div class="text-muted small">Сумма кредита:</div>
                                <div class="fs-4 fw-bold text-primary">@App.LoanAmount.ToString("N2") ₽</div>
                            </div>
                            <div class="col-sm-4">
                                <div class="text-muted small">Срок:</div>
                                <div class="fs-4 fw-bold text-dark">@App.LoanTermMonths мес.</div>
                            </div>
                            <div class="col-sm-4">
                                <div class="text-muted small">Процентная ставка:</div>
                                <div class="fs-4 fw-bold text-dark">@App.InterestRate.ToString("N2")%</div>
                            </div>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="row g-3">
                            <div class="col-sm-4">
                                <div class="text-muted small">Ежемесячный платеж:</div>
                                <div class="fs-5 fw-bold text-success">@App.MonthlyPayment.ToString("N2") ₽</div>
                            </div>
                            <div class="col-sm-4">
                                <div class="text-muted small">Общая выплата:</div>
                                <div class="fs-5 fw-bold text-dark">@App.TotalPayment.ToString("N2") ₽</div>
                            </div>
                            <div class="col-sm-4">
                                <div class="text-muted small">Переплата (проценты):</div>
                                <div class="fs-5 fw-bold text-secondary">@App.TotalOverpayment.ToString("N2") ₽</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(App.StatusComment))
                        {
                            <div class="mt-4 p-3 bg-light rounded-3 border">
                                <div class="small fw-bold text-muted mb-1">Обоснование / Решение андеррайтера:</div>
                                <div class="text-dark">@App.StatusComment</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Client Card -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0"><i class="bi bi-person-badge text-primary me-2"></i> Карточка клиента</h5>
                        @if (App.Client != null)
                        {
                            <a href="clients/@App.Client.Id" class="btn btn-sm btn-outline-primary">
                                Полная карточка клиента →
                            </a>
                        }
                    </div>
                    <div class="card-body p-4">
                        @if (App.Client != null)
                        {
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="text-muted small">ФИО клиента:</div>
                                    <div class="fw-bold text-dark fs-6">@App.Client.FullName</div>
                                    <div class="small text-muted">Дата рождения: @App.Client.BirthDate.ToString("dd.MM.yyyy") (@App.Client.Age лет)</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Кредитный рейтинг скоринга:</div>
                                    <span class="badge @GetRatingBadge(App.Client.CreditRating) fs-6 mt-1">
                                        @App.Client.CreditRating
                                    </span>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Паспортные данные:</div>
                                    <div class="fw-medium font-monospace">@App.Client.PassportSeries @App.Client.PassportNumber</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">ИНН:</div>
                                    <div class="fw-medium font-monospace">@App.Client.TaxNumber</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Телефон:</div>
                                    <div class="fw-medium">@App.Client.PhoneNumber</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Электронная почта:</div>
                                    <div class="fw-medium">@App.Client.Email</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Ежемесячный доход:</div>
                                    <div class="fw-bold text-success fs-5">@App.Client.MonthlyIncome.ToString("N0") ₽</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Статус занятости:</div>
                                    <div class="fw-medium">@App.Client.EmploymentStatus</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-muted small">Адрес регистрации:</div>
                                    <div class="fw-medium text-dark">@App.Client.RegistrationAddress</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Documents & Status Timeline -->
            <div class="col-lg-5">
                <!-- Attached Documents Section -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-paperclip text-primary me-2"></i> Документы
                            <span class="badge bg-light text-dark border ms-1">@App.Documents.Count</span>
                        </h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowUploadModal = true">
                            <i class="bi bi-upload"></i> Прикрепить
                        </button>
                    </div>
                    <div class="card-body p-3">
                        @if (App.Documents.Count == 0)
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-file-earmark-arrow-up fs-3 d-block mb-1 text-secondary"></i>
                                К заявке еще не прикреплено ни одного документа
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var doc in App.Documents)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold small text-dark d-flex align-items-center gap-1">
                                                <i class="bi bi-file-earmark-pdf text-danger"></i>
                                                @doc.FileName
                                            </div>
                                            <div class="text-muted" style="font-size: 0.75rem;">
                                                @doc.DocumentType • @doc.FormattedSize • @doc.UploadedAt.ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <a href="/api/documents/@doc.Id/download" target="_blank"
                                               class="btn btn-sm btn-outline-secondary py-1 px-2" title="Скачать документ">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger py-1 px-2"
                                                    @onclick="() => DeleteDoc(doc.Id)" title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Status Transition History -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i> История переходов</h5>
                    </div>
                    <div class="card-body p-3">
                        @if (App.StatusHistory.Count == 0)
                        {
                            <div class="text-muted small text-center py-3">История отсутствует</div>
                        }
                        else
                        {
                            <div class="timeline ps-3 border-start border-2 border-primary">
                                @foreach (var h in App.StatusHistory)
                                {
                                    <div class="mb-3 position-relative ps-3">
                                        <div class="small fw-bold text-dark">
                                            @h.NewStatusTitle
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            @h.ChangedAt.ToString("dd.MM.yyyy HH:mm") • @h.ChangedByUserName
                                        </div>
                                        @if (!string.IsNullOrEmpty(h.Comment))
                                        {
                                            <div class="small text-secondary mt-1 bg-light p-2 rounded border">
                                                @h.Comment
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Change Status -->
@if (ShowStatusModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Изменение статуса заявки</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowStatusModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Перевод заявки <strong>@App?.ApplicationNumber</strong> в статус:
                        <span class="badge @GetStatusBadge(TargetStatus) fs-6 ms-1">@TargetStatus</span>
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">
                            Комментарий / Обоснование решения @(TargetStatus == ApplicationStatus.Approved || TargetStatus == ApplicationStatus.Rejected ? "*" : ""):
                        </label>
                        <textarea class="form-control" rows="3" placeholder="Укажите причину или заключение андеррайтера..."
                                  @bind="StatusChangeComment"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowStatusModal = false">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmStatusChange">Подтвердить</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Upload Document -->
@if (ShowUploadModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Прикрепление документа</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowUploadModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Тип документа:</label>
                        <select class="form-select" @bind="UploadType">
                            <option value="@DocumentType.Passport">Паспорт гражданина РФ</option>
                            <option value="@DocumentType.IncomeStatement">Справка о доходах (2-НДФЛ / по форме банка)</option>
                            <option value="@DocumentType.EmploymentContract">Трудовой договор / трудовая книжка</option>
                            <option value="@DocumentType.CollateralDocument">Документы на залоговое имущество</option>
                            <option value="@DocumentType.Other">Иной документ</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Выберите файл (до 10 МБ):</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" />
                    </div>

                    @if (SelectedFile != null)
                    {
                        <div class="small text-muted">
                            Выбран файл: <strong>@SelectedFile.Name</strong> (@(SelectedFile.Size / 1024) KB)
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowUploadModal = false">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadDocumentAsync" disabled="@(SelectedFile == null)">
                        Загрузить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ApplicationDto? App;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private bool ShowStatusModal = false;
    private ApplicationStatus TargetStatus;
    private string? StatusChangeComment;

    private bool ShowUploadModal = false;
    private DocumentType UploadType = DocumentType.IncomeStatement;
    private IBrowserFile? SelectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationAsync();
    }

    private async Task LoadApplicationAsync()
    {
        App = await ApplicationService.GetByIdAsync(Id);
    }

    private void PromptStatusChange(ApplicationStatus status)
    {
        TargetStatus = status;
        StatusChangeComment = "";
        ShowStatusModal = true;
    }

    private async Task ConfirmStatusChange()
    {
        ShowStatusModal = false;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "system";
            var userName = user.Identity?.Name ?? "Оператор";
            var roleStr = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            var userRole = Enum.TryParse<UserRole>(roleStr, true, out var r) ? r : UserRole.Operator;

            var dto = new ChangeStatusDto
            {
                NewStatus = TargetStatus,
                Comment = StatusChangeComment
            };

            App = await ApplicationService.ChangeStatusAsync(Id, dto, userId, userName, userRole);
            SuccessMessage = $"Статус заявки успешно изменен на '{App.StatusTitle}'.";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
    }

    private async Task UploadDocumentAsync()
    {
        if (SelectedFile == null) return;
        ErrorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "system";
            var userName = user.Identity?.Name ?? "Оператор";

            using var stream = SelectedFile.OpenReadStream(10 * 1024 * 1024);
            var uploadDto = new UploadDocumentDto
            {
                ApplicationId = Id,
                DocumentType = UploadType,
                FileName = SelectedFile.Name,
                ContentType = SelectedFile.ContentType,
                Stream = stream,
                Length = SelectedFile.Size
            };

            await DocumentService.UploadAsync(uploadDto, userId, userName);
            ShowUploadModal = false;
            SelectedFile = null;
            SuccessMessage = "Документ успешно прикреплен к заявке.";
            await LoadApplicationAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DeleteDoc(Guid docId)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "system";
            var userName = user.Identity?.Name ?? "Оператор";

            await DocumentService.DeleteAsync(docId, userId, userName);
            SuccessMessage = "Документ удален.";
            await LoadApplicationAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private static string GetStatusBadge(ApplicationStatus status) => status switch
    {
        ApplicationStatus.New => "bg-primary",
        ApplicationStatus.InProgress => "bg-warning text-dark",
        ApplicationStatus.Approved => "bg-success",
        ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetRatingBadge(CreditRating rating) => rating switch
    {
        CreditRating.Excellent => "bg-success",
        CreditRating.Good => "bg-info text-dark",
        CreditRating.Fair => "bg-warning text-dark",
        _ => "bg-danger"
    };

    private static string GetProductTitle(ProductType type) => type switch
    {
        ProductType.ConsumerLoan => "Потребительский кредит",
        ProductType.Mortgage => "Ипотека",
        ProductType.AutoLoan => "Автокредит",
        ProductType.BusinessLoan => "Бизнес-кредит",
        _ => type.ToString()
    };
}
