@page "/applications"
@rendermode InteractiveServer
@inject IApplicationService ApplicationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Реестр кредитных заявок | Банк «ФИНАНСОВЫЙ СТАНДАРТ»</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Реестр кредитных заявок</h2>
            <p class="text-muted mb-0">Поиск, фильтрация, управление статусами и выгрузка отчетов</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/api/reports/excel" target="_blank" class="btn btn-outline-success d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-excel"></i> Экспорт в Excel
            </a>
            <a href="applications/create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Новая заявка
            </a>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Поиск</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Номер, ФИО, ИНН..."
                               @bind="Filter.Search" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Статус</label>
                    <select class="form-select form-select-sm" @bind="SelectedStatusString">
                        <option value="">Все статусы</option>
                        <option value="New">Новая</option>
                        <option value="InProgress">В обработке</option>
                        <option value="Approved">Одобрена</option>
                        <option value="Rejected">Отклонена</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Продукт</label>
                    <select class="form-select form-select-sm" @bind="SelectedProductString">
                        <option value="">Все продукты</option>
                        <option value="ConsumerLoan">Потребительский</option>
                        <option value="Mortgage">Ипотека</option>
                        <option value="AutoLoan">Автокредит</option>
                        <option value="BusinessLoan">Бизнес-кредит</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Сортировка</label>
                    <select class="form-select form-select-sm" @bind="Filter.SortBy">
                        <option value="CreatedAt">По дате создания</option>
                        <option value="Amount">По сумме</option>
                        <option value="Client">По клиенту</option>
                        <option value="Number">По номеру</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-sm btn-primary w-100" @onclick="LoadApplicationsAsync">
                        <i class="bi bi-funnel"></i> Применить
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFiltersAsync" title="Сбросить фильтры">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="text-muted small">Найдено записей: <strong class="text-dark">@TotalCount</strong></span>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="sortDesc" @bind="Filter.SortDescending" @bind:after="LoadApplicationsAsync">
                <label class="form-check-label small text-muted" for="sortDesc">Сначала новые</label>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Номер заявки</th>
                        <th>Дата подачи</th>
                        <th>Заемщик</th>
                        <th>Кредитный продукт</th>
                        <th>Сумма (₽)</th>
                        <th>Срок</th>
                        <th>Ставка</th>
                        <th>Статус</th>
                        <th>Документы</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span class="ms-2 text-muted">Загрузка данных реестра...</span>
                            </td>
                        </tr>
                    }
                    else if (Applications.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Заявок по заданным критериям не найдено
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var app in Applications)
                        {
                            <tr>
                                <td class="fw-bold">
                                    <a href="applications/@app.Id" class="text-decoration-none">
                                        @app.ApplicationNumber
                                    </a>
                                </td>
                                <td class="small text-muted">@app.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-medium">@app.ClientFullName</div>
                                    <div class="small text-muted font-monospace">ИНН: @app.ClientTaxNumber</div>
                                </td>
                                <td>@GetProductTitle(app.ProductType)</td>
                                <td class="fw-bold">@app.LoanAmount.ToString("N2") ₽</td>
                                <td>@app.LoanTermMonths мес.</td>
                                <td>@app.InterestRate.ToString("N1")%</td>
                                <td>
                                    <span class="badge @GetStatusBadge(app.Status)">@app.StatusTitle</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-paperclip me-1"></i>@app.DocumentsCount
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="applications/@app.Id" class="btn btn-sm btn-outline-primary" title="Открыть карточку заявки">
                                        Детали →
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Страница @Filter.PageNumber из @TotalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Filter.PageNumber <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(Filter.PageNumber - 1)">Предыдущая</button>
                        </li>
                        @for (var p = 1; p <= TotalPages; p++)
                        {
                            var pageIndex = p;
                            <li class="page-item @(Filter.PageNumber == pageIndex ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                            </li>
                        }
                        <li class="page-item @(Filter.PageNumber >= TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(Filter.PageNumber + 1)">Следующая</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@code {
    private List<ApplicationSummaryDto> Applications = new();
    private int TotalCount = 0;
    private bool IsLoading = true;
    private ApplicationFilterDto Filter = new() { PageSize = 15 };

    private string SelectedStatusString
    {
        get => Filter.Status?.ToString() ?? "";
        set
        {
            if (string.IsNullOrEmpty(value))
                Filter.Status = null;
            else if (Enum.TryParse<ApplicationStatus>(value, out var s))
                Filter.Status = s;
        }
    }

    private string SelectedProductString
    {
        get => Filter.ProductType?.ToString() ?? "";
        set
        {
            if (string.IsNullOrEmpty(value))
                Filter.ProductType = null;
            else if (Enum.TryParse<ProductType>(value, out var p))
                Filter.ProductType = p;
        }
    }

    private int TotalPages => (int)Math.Ceiling((double)TotalCount / Filter.PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        IsLoading = true;
        try
        {
            var result = await ApplicationService.GetPagedAsync(Filter);
            Applications = result.Items;
            TotalCount = result.TotalCount;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadApplicationsAsync();
        }
    }

    private async Task ResetFiltersAsync()
    {
        Filter = new ApplicationFilterDto { PageSize = 15 };
        await LoadApplicationsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages) return;
        Filter.PageNumber = newPage;
        await LoadApplicationsAsync();
    }

    private static string GetStatusBadge(ApplicationStatus status) => status switch
    {
        ApplicationStatus.New => "bg-primary",
        ApplicationStatus.InProgress => "bg-warning text-dark",
        ApplicationStatus.Approved => "bg-success",
        ApplicationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetProductTitle(ProductType type) => type switch
    {
        ProductType.ConsumerLoan => "Потребительский",
        ProductType.Mortgage => "Ипотека",
        ProductType.AutoLoan => "Автокредит",
        ProductType.BusinessLoan => "Бизнес",
        _ => type.ToString()
    };
}
