@page "/clients"
@rendermode InteractiveServer
@inject IClientService ClientService
@inject NavigationManager Navigation

<PageTitle>Картотека клиентов | Банк «ФИНАНСОВЫЙ СТАНДАРТ»</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Картотека клиентов</h2>
            <p class="text-muted mb-0">База физических лиц, кредитные скоринги и история обращений</p>
        </div>
        <div>
            <a href="clients/create" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-person-plus"></i> Зарегистрировать клиента
            </a>
        </div>
    </div>

    <!-- Search Box -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0"
                               placeholder="Поиск по ФИО, ИНН, паспорту, номеру телефона..."
                               @bind="SearchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary w-100" @onclick="LoadClientsAsync">
                        Найти
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ResetSearchAsync" title="Сбросить поиск">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Clients Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="text-muted small">Всего клиентов в выборке: <strong class="text-dark">@Clients.Count</strong></span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ФИО Клиента</th>
                        <th>Возраст</th>
                        <th>Паспортные данные</th>
                        <th>ИНН</th>
                        <th>Контакты</th>
                        <th>Доход в месяц</th>
                        <th>Рейтинг</th>
                        <th>Активные заявки</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span class="ms-2 text-muted">Загрузка клиентов...</span>
                            </td>
                        </tr>
                    }
                    else if (Clients.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2 text-secondary"></i>
                                Клиентов не найдено
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Clients)
                        {
                            <tr>
                                <td>
                                    <a href="clients/@c.Id" class="fw-bold text-decoration-none">
                                        @c.FullName
                                    </a>
                                    <div class="text-muted small">@c.EmploymentStatus</div>
                                </td>
                                <td>@c.Age лет</td>
                                <td class="font-monospace small">@c.PassportSeries @c.PassportNumber</td>
                                <td class="font-monospace small">@c.TaxNumber</td>
                                <td>
                                    <div class="small">@c.PhoneNumber</div>
                                    <div class="small text-muted">@c.Email</div>
                                </td>
                                <td class="fw-bold text-success">@c.MonthlyIncome.ToString("N0") ₽</td>
                                <td>
                                    <span class="badge @GetRatingBadge(c.CreditRating)">@c.CreditRating</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@c.ActiveApplicationsCount</span>
                                </td>
                                <td class="text-end">
                                    <a href="clients/@c.Id" class="btn btn-sm btn-outline-primary" title="Открыть карточку клиента">
                                        Карточка →
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ClientDto> Clients = new();
    private string? SearchQuery;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        IsLoading = true;
        try
        {
            Clients = await ClientService.GetAllAsync(SearchQuery);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadClientsAsync();
        }
    }

    private async Task ResetSearchAsync()
    {
        SearchQuery = null;
        await LoadClientsAsync();
    }

    private static string GetRatingBadge(CreditRating rating) => rating switch
    {
        CreditRating.Excellent => "bg-success",
        CreditRating.Good => "bg-info text-dark",
        CreditRating.Fair => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
