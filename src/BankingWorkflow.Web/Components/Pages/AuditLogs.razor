@page "/audit-logs"
@attribute [Authorize(Roles = "Manager,Admin")]
@rendermode InteractiveServer
@inject IAuditService AuditService

<PageTitle>Журнал действий пользователей | Банк «ФИНАНСОВЫЙ СТАНДАРТ»</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Журнал аудита действий пользователей</h2>
            <p class="text-muted mb-0">Фиксация всех значимых бизнес-событий, переходов статусов и работы с документами</p>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Поиск по действию, пользователю, описанию..."
                               @bind="Filter.Search" @bind:event="oninput" @onkeyup="HandleKeyUp" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="Filter.EntityName">
                        <option value="">Все объекты</option>
                        <option value="Application">Заявки (Application)</option>
                        <option value="Client">Клиенты (Client)</option>
                        <option value="Document">Документы (Document)</option>
                        <option value="User">Пользователи (User)</option>
                        <option value="System">Система (System)</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-sm btn-primary w-100" @onclick="LoadLogsAsync">
                        Применить
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilterAsync" title="Сбросить фильтр">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="text-muted small">Всего записей аудита: <strong class="text-dark">@TotalCount</strong></span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 font-monospace small">
                <thead class="table-light font-sans-serif">
                    <tr>
                        <th>Время события</th>
                        <th>Пользователь</th>
                        <th>Действие</th>
                        <th>Сущность</th>
                        <th>Идентификатор</th>
                        <th>Подробности</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span class="ms-2 text-muted">Загрузка журнала аудита...</span>
                            </td>
                        </tr>
                    }
                    else if (Logs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Записей аудита не найдено
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Logs)
                        {
                            <tr>
                                <td class="text-muted">@log.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @log.UserName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetActionBadge(log.Action)">
                                        @log.Action
                                    </span>
                                </td>
                                <td>@log.EntityName</td>
                                <td class="text-muted">@(log.EntityId ?? "—")</td>
                                <td class="text-dark text-wrap" style="max-width: 450px;">@log.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">Страница @Filter.PageNumber из @TotalPages</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Filter.PageNumber <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(Filter.PageNumber - 1)">Предыдущая</button>
                        </li>
                        @for (var p = 1; p <= TotalPages; p++)
                        {
                            var pageIndex = p;
                            <li class="page-item @(Filter.PageNumber == pageIndex ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                            </li>
                        }
                        <li class="page-item @(Filter.PageNumber >= TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(Filter.PageNumber + 1)">Следующая</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLogDto> Logs = new();
    private int TotalCount = 0;
    private bool IsLoading = true;
    private AuditLogFilterDto Filter = new() { PageSize = 25 };

    private int TotalPages => (int)Math.Ceiling((double)TotalCount / Filter.PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        IsLoading = true;
        try
        {
            var result = await AuditService.GetPagedAsync(Filter);
            Logs = result.Items;
            TotalCount = result.TotalCount;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadLogsAsync();
        }
    }

    private async Task ResetFilterAsync()
    {
        Filter = new AuditLogFilterDto { PageSize = 25 };
        await LoadLogsAsync();
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages) return;
        Filter.PageNumber = newPage;
        await LoadLogsAsync();
    }

    private static string GetActionBadge(string action) => action switch
    {
        "CHANGE_STATUS" => "bg-warning text-dark",
        "CREATE_APPLICATION" => "bg-primary",
        "CREATE_CLIENT" => "bg-info text-dark",
        "UPLOAD_DOCUMENT" => "bg-purple text-dark",
        "DELETE_APPLICATION" or "DELETE_CLIENT" => "bg-danger",
        _ => "bg-secondary"
    };
}
