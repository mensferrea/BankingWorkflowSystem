<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <div class="container mt-5 text-center">
                    <div class="card p-5 shadow-sm border-0 mx-auto" style="max-width: 500px;">
                        <div class="text-danger mb-3" style="font-size: 3rem;">⚠️</div>
                        <h3 class="fw-bold">Доступ ограничен</h3>
                        <p class="text-muted">У вашей роли нет достаточных прав для просмотра этой страницы.</p>
                        <a href="/" class="btn btn-primary mt-2">Вернуться на Главную</a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
